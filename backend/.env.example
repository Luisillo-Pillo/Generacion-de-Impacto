# Copia este archivo a .env (NO se sube a git) y completa los valores.
# En Render, define estas mismas variables en Environment.

PORT=4000

# Cadena de conexión de MongoDB Atlas (reemplaza <db_user>, <db_password> y <cluster> con los datos reales)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/generacion_impacto?retryWrites=true&w=majority

# Cadena larga y aleatoria para firmar sesiones (genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=cambia-esto

# Orígenes permitidos (CORS), separados por coma. Pon aquí la URL de Vercel.
CORS_ORIGIN=http://localhost:5173
